// OBA Platform — Phase 1 (Core HR & Payroll) data model.
// Datasource URL resolution: Vercel Postgres integrations set POSTGRES_PRISMA_URL
// (pooled, pgbouncer) alongside DATABASE_URL / POSTGRES_URL (direct). We read
// whichever is present via the DATABASE_URL env var itself, which our own
// bootstrap (lib/db.js env normalization) guarantees is populated from
// POSTGRES_PRISMA_URL / POSTGRES_URL / DATABASE_URL, in that order of
// preference, before `next build`/`next start` ever touch this file.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DIRECTOR
  HR_OFFICER
  BUSINESS_DEVELOPMENT
  OPERATIONS_MANAGER
  ACCOUNTANT
  IT_FACILITIES
  SUPERVISOR
  TRAINER
  QA_ANALYST
  EMPLOYEE
  CLIENT
  BOARD_ADVISOR
}

enum DocumentCategory {
  CONTRACT
  ID
  CERTIFICATE
  SOP
  POLICY
  OTHER
}

enum ShiftType {
  DAY
  EVENING
  NIGHT
}

enum AttendanceStatus {
  ON_TIME
  LATE
  ABSENT
}

enum LeaveType {
  ANNUAL
  SICK
  COMPASSIONATE
  MATERNITY_PATERNITY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayrollRunStatus {
  DRAFT
  APPROVED
  PAID
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         Role
  employeeId   String?   @unique
  employee     Employee? @relation(fields: [employeeId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  resetTokens        PasswordResetToken[]
  auditEntries       AuditLogEntry[]
  createdRosterRows  ShiftRosterEntry[]    @relation("RosterCreatedBy")
  correctedAttendance AttendanceRecord[]   @relation("AttendanceCorrectedBy")
  decidedLeaves      LeaveRequest[]        @relation("LeaveDecidedBy")
  createdPayrollRuns PayrollRun[]          @relation("PayrollCreatedBy")
  approvedPayrollRuns PayrollRun[]         @relation("PayrollApprovedBy")
  uploadedDocuments  Document[]            @relation("DocumentUploadedBy")
  updatedSettings    PayrollSettings[]     @relation("SettingsUpdatedBy")
}

model Employee {
  id                       String    @id @default(cuid())
  name                     String
  jobTitle                 String
  branch                   String
  startDate                DateTime
  salaryGross              Decimal   @db.Decimal(12, 2)
  bankName                 String?
  bankAccountNumber        String?
  mobileMoneyProvider      String?
  mobileMoneyNumber        String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  active                   Boolean   @default(true)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  user               User?
  documents          Document[]
  attendanceRecords  AttendanceRecord[]
  leaveRequests      LeaveRequest[]
  payslips           Payslip[]
  rosterEntries      ShiftRosterEntry[]
}

model Document {
  id             String            @id @default(cuid())
  employeeId     String?           // null = company-wide document (SOP, policy, client contract), not tied to one person
  employee       Employee?         @relation(fields: [employeeId], references: [id])
  category       DocumentCategory
  fileName       String
  mimeType       String
  sizeBytes      Int
  fileDataUrl    String            @db.Text // placeholder store; real deployment would use Vercel Blob/S3
  signed         Boolean           @default(false)
  expiresAt      DateTime?
  notes          String?
  uploadedByUserId String
  uploadedBy     User              @relation("DocumentUploadedBy", fields: [uploadedByUserId], references: [id])
  createdAt      DateTime          @default(now())
}

model ShiftRosterEntry {
  id              String    @id @default(cuid())
  branch          String
  weekStart       DateTime
  dayOfWeek       Int // 0=Mon .. 6=Sun
  shiftType       ShiftType
  employeeId      String?
  employee        Employee? @relation(fields: [employeeId], references: [id])
  published       Boolean   @default(false)
  publishedAt     DateTime?
  createdByUserId String?
  createdBy       User?     @relation("RosterCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([branch, weekStart, dayOfWeek, shiftType])
}

model AttendanceRecord {
  id                  String            @id @default(cuid())
  employeeId          String
  employee            Employee         @relation(fields: [employeeId], references: [id])
  date                DateTime
  clockIn             DateTime?
  clockOut            DateTime?
  status              AttendanceStatus  @default(ON_TIME)
  correctedByUserId   String?
  correctedBy         User?             @relation("AttendanceCorrectedBy", fields: [correctedByUserId], references: [id])
  correctionNote      String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([employeeId, date])
}

model LeaveRequest {
  id              String      @id @default(cuid())
  employeeId      String
  employee        Employee    @relation(fields: [employeeId], references: [id])
  type            LeaveType
  startDate       DateTime
  endDate         DateTime
  days            Int
  status          LeaveStatus @default(PENDING)
  reason          String?
  decidedByUserId String?
  decidedBy       User?       @relation("LeaveDecidedBy", fields: [decidedByUserId], references: [id])
  decidedAt       DateTime?
  createdAt       DateTime    @default(now())
}

model PayrollRun {
  id                String           @id @default(cuid())
  period            String // e.g. "2026-07"
  status            PayrollRunStatus @default(DRAFT)
  createdByUserId   String
  createdBy         User             @relation("PayrollCreatedBy", fields: [createdByUserId], references: [id])
  approvedByUserId  String?
  approvedBy        User?            @relation("PayrollApprovedBy", fields: [approvedByUserId], references: [id])
  approvedAt        DateTime?
  createdAt         DateTime         @default(now())

  payslips Payslip[]

  @@unique([period])
}

model Payslip {
  id               String     @id @default(cuid())
  payrollRunId     String
  payrollRun       PayrollRun @relation(fields: [payrollRunId], references: [id])
  employeeId       String
  employee         Employee   @relation(fields: [employeeId], references: [id])
  grossPay         Decimal    @db.Decimal(12, 2)
  overtimePay      Decimal    @db.Decimal(12, 2) @default(0)
  otherDeductions  Decimal    @db.Decimal(12, 2) @default(0)
  deductionNote    String?
  ssnitEmployee    Decimal    @db.Decimal(12, 2)
  ssnitEmployer    Decimal    @db.Decimal(12, 2)
  payeTax          Decimal    @db.Decimal(12, 2)
  netPay           Decimal    @db.Decimal(12, 2)
  createdAt        DateTime   @default(now())

  @@unique([payrollRunId, employeeId])
}

// Real, editable statutory-rate table — never hard-code SSNIT/PAYE in app logic.
// Seeded with plausible current-ish Ghana rates; FLAGGED as placeholders
// pending accountant/Director sign-off (see brief's compliance note).
model PayrollSettings {
  id                    String   @id @default(cuid())
  ssnitEmployeeRatePct  Decimal  @db.Decimal(5, 2) // employee SSNIT contribution, e.g. 5.5
  ssnitEmployerRatePct  Decimal  @db.Decimal(5, 2) // employer SSNIT contribution, e.g. 13.0
  payeBands             Json     // [{ upTo: number|null, rate: number }] cumulative monthly GHS bands
  effectiveFrom         DateTime @default(now())
  notes                 String?
  updatedByUserId       String?
  updatedBy             User?    @relation("SettingsUpdatedBy", fields: [updatedByUserId], references: [id])
  updatedAt             DateTime @updatedAt
  createdAt             DateTime @default(now())
}

model AuditLogEntry {
  id            String   @id @default(cuid())
  actorUserId   String?
  actor         User?    @relation(fields: [actorUserId], references: [id])
  actorEmail    String
  action        String
  targetType    String
  targetId      String?
  detail        Json?
  createdAt     DateTime @default(now())
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}
