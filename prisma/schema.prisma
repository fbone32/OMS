// OBA Platform — Phase 1 (Core HR & Payroll) data model.
// Datasource URL resolution: Vercel Postgres integrations set POSTGRES_PRISMA_URL
// (pooled, pgbouncer) alongside DATABASE_URL / POSTGRES_URL / POSTGRES_URL_NON_POOLING.
// `url` (used by the generated client at request time) and `DIRECT_URL` (used only
// by `prisma migrate` commands, which need a non-pooled connection for their
// session-level advisory locks) are both populated by scripts/vercel-build.mjs at
// build time and by lib/db.js's runtime fallback, in that order of preference,
// before this file's env() calls are ever read.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  DIRECTOR
  HR_OFFICER
  BUSINESS_DEVELOPMENT
  OPERATIONS_MANAGER
  ACCOUNTANT
  IT_FACILITIES
  SUPERVISOR
  TRAINER
  QA_ANALYST
  EMPLOYEE
  CLIENT
  BOARD_ADVISOR
}

enum DocumentCategory {
  CONTRACT
  ID
  CERTIFICATE
  SOP
  POLICY
  // Phase 3 (Compliance Store) — a small, additive extension of the existing
  // Document model rather than a parallel system: policies/contracts that
  // are specifically compliance artifacts (data protection, regulatory,
  // audit sign-off, etc.) get their own filterable category, but still flow
  // through the exact same upload/view/download permission model as every
  // other document (see lib/roles.js DOCUMENTS_UPLOAD/DOCUMENTS_VIEW and
  // app/api/documents/[id]/download's canDownload rule).
  COMPLIANCE
  OTHER
}

enum ShiftType {
  DAY
  EVENING
  NIGHT
}

enum AttendanceStatus {
  ON_TIME
  LATE
  ABSENT
}

enum LeaveType {
  ANNUAL
  SICK
  COMPASSIONATE
  MATERNITY_PATERNITY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayrollRunStatus {
  DRAFT
  APPROVED
  PAID
}

// ---- Phase 2 (Operations & Performance) enums ----

enum JobOpeningStatus {
  OPEN
  ON_HOLD
  CLOSED
}

// Matches the fixed "TYPE" dropdown already in the Recruitment pipeline UI's
// candidate stage columns (applied -> screening -> interview -> offer ->
// hired), plus REJECTED for a candidate dropped at any stage.
enum CandidateStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

// Matches the fixed "TYPE" dropdown already in the existing Incidents "Log
// incident" form (Lateness / Unapproved absence / QA breach / Conduct /
// Safety) — never invent a different set, the <select> options are the
// source of truth for what this enum must contain.
enum IncidentType {
  LATENESS
  UNAPPROVED_ABSENCE
  QA_BREACH
  CONDUCT
  SAFETY
}

// Not a form field in the existing UI (the "Log incident" panel has no
// severity selector) — server-derived from IncidentType at creation time so
// the data model captures it for real without inventing a new UI control.
enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
}

enum IncidentStatus {
  OPEN
  CLOSED
}

enum CourseStatus {
  LIVE
  MANDATORY
  DRAFT
}

enum TrainingStatus {
  ENROLLED
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

// Only the metrics Phase 1 data can genuinely support today (attendance rate,
// QA score). SLA / ticket volume / revenue need Client (Phase 3) and a
// ticketing system (not yet built) — deliberately not modeled as real
// KpiTargets to avoid fabricating a number behind a "real" label.
enum KpiMetricKey {
  ATTENDANCE
  QA_SCORE
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         Role
  employeeId   String?   @unique
  employee     Employee? @relation(fields: [employeeId], references: [id])
  // Phase 4 (Client Portal) — set only on Role=CLIENT accounts, created by
  // the Sales & CRM "convert deal to client" flow. Deliberately NOT unique:
  // a client may eventually have more than one portal login, but every
  // portal-scoped API route filters strictly on this field server-side (see
  // lib/roles.js PORTAL_VIEW + app/api/portal/**), never trusting a
  // client-supplied clientId, so cross-client data never leaks regardless.
  clientId     String?
  client       Client?   @relation(fields: [clientId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  resetTokens         PasswordResetToken[]
  auditEntries        AuditLogEntry[]
  createdRosterRows   ShiftRosterEntry[]   @relation("RosterCreatedBy")
  correctedAttendance AttendanceRecord[]   @relation("AttendanceCorrectedBy")
  decidedLeaves       LeaveRequest[]       @relation("LeaveDecidedBy")
  createdPayrollRuns  PayrollRun[]         @relation("PayrollCreatedBy")
  approvedPayrollRuns PayrollRun[]         @relation("PayrollApprovedBy")
  uploadedDocuments   Document[]           @relation("DocumentUploadedBy")
  updatedSettings     PayrollSettings[]    @relation("SettingsUpdatedBy")

  // ---- Phase 2 (Operations & Performance) ----
  createdJobOpenings JobOpening[]         @relation("JobOpeningCreatedBy")
  qaAuditsGiven      QaAudit[]            @relation("QaAuditedBy")
  incidentsOwned     Incident[]           @relation("IncidentOwner")
  incidentsClosed    Incident[]           @relation("IncidentClosedBy")
  trainingRecorded   TrainingCompletion[] @relation("TrainingRecordedBy")
  kpiTargetsUpdated  KpiTarget[]          @relation("KpiTargetUpdatedBy")

  // ---- Phase 3 (Client Portal & Assets — Asset Tracking / IT & Facilities) ----
  assetsRegistered     Asset[]              @relation("AssetRegisteredBy")
  assetsAssigned       Asset[]              @relation("AssetAssignedBy")
  ticketsReported      ITTicket[]           @relation("TicketReportedBy")
  ticketsResolved      ITTicket[]           @relation("TicketResolvedBy")
  systemStatusUpdated  SystemStatus[]       @relation("SystemStatusUpdatedBy")
  maintenanceCreated   MaintenanceTask[]    @relation("MaintenanceCreatedBy")
  procurementRequested ProcurementRequest[] @relation("ProcurementRequestedBy")
  procurementDecided   ProcurementRequest[] @relation("ProcurementDecidedBy")
  procurementReceived  ProcurementRequest[] @relation("ProcurementReceivedBy")

  // ---- Phase 4 (Growth & Finance) ----
  dealsCreated            Deal[]              @relation("DealCreatedBy")
  dealContactLogsCreated  DealContactLog[]    @relation("DealContactLogCreatedBy")
  contractsCreated        Contract[]          @relation("ContractCreatedBy")
  contractsReminded       Contract[]          @relation("ContractReminderBy")
  expensesCreated         Expense[]           @relation("ExpenseCreatedBy")
  bankLinesImported       BankStatementLine[] @relation("BankLineImportedBy")
  bankLinesMatched        BankStatementLine[] @relation("BankLineMatchedBy")
  taxFilingsFiled         TaxFiling[]         @relation("TaxFilingFiledBy")
  vaultCredentialsCreated VaultCredential[]   @relation("VaultCredentialCreatedBy")
  invoicesCreated         Invoice[]              @relation("InvoiceCreatedBy")
  invoiceTaxSettingsUpdated InvoiceTaxSettings[] @relation("InvoiceTaxSettingsUpdatedBy")
  supportRequestsCreated  ClientSupportRequest[]  @relation("SupportRequestCreatedBy")
  supportMessagesAuthored ClientSupportMessage[] @relation("SupportMessageAuthor")
}

model Employee {
  id                       String   @id @default(cuid())
  name                     String
  jobTitle                 String
  branch                   String
  startDate                DateTime
  salaryGross              Decimal? @db.Decimal(12, 2)
  nationalId               String? // Ghana Card number — optional/fillable-later at onboarding, same as salary/banking
  bankName                 String?
  bankAccountNumber        String?
  mobileMoneyProvider      String?
  mobileMoneyNumber        String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  active                   Boolean  @default(true)
  // Phase 4 (Client Portal) — which client account, if any, this person is
  // staffed to service. Optional/nullable: most Phase 1-3 employees are
  // internal-only and never assigned to a client. Set by Director/Ops
  // Manager via the employee record; drives the Client Portal's "your team
  // roster" (see app/api/portal/summary), never the reverse.
  clientId                 String?
  client                   Client?  @relation(fields: [clientId], references: [id])
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user              User?
  documents         Document[]
  attendanceRecords AttendanceRecord[]
  leaveRequests     LeaveRequest[]
  payslips          Payslip[]
  rosterEntries     ShiftRosterEntry[]
  contracts         Contract[]

  // ---- Phase 2 (Operations & Performance) ----
  hiredFromCandidate  Candidate? // reverse of Candidate.convertedEmployeeId (1:1)
  qaAudits            QaAudit[]
  incidents           Incident[]
  trainingCompletions TrainingCompletion[]

  // ---- Phase 3 (Asset Tracking) ----
  assignedAssets Asset[]
}

model Document {
  id               String           @id @default(cuid())
  employeeId       String? // null = company-wide document (SOP, policy, client contract), not tied to one person
  employee         Employee?        @relation(fields: [employeeId], references: [id])
  // Phase 4 (Client Portal) — set when this document belongs to a specific
  // Client (their MSA, SLA schedule, data protection addendum, etc.),
  // matching the existing Employee.clientId pattern: optional, additive,
  // never required. Company-wide docs (employeeId AND clientId both null)
  // and personal employee docs are unaffected. Surfaced to that Client's
  // portal login via app/api/portal/documents — never through the general
  // internal /api/documents route's own access rules changing.
  clientId         String?
  client           Client?          @relation(fields: [clientId], references: [id])
  category         DocumentCategory
  fileName         String
  mimeType         String
  sizeBytes        Int
  fileDataUrl      String           @db.Text // placeholder store; real deployment would use Vercel Blob/S3
  signed           Boolean          @default(false)
  expiresAt        DateTime?
  notes            String?
  uploadedByUserId String
  uploadedBy       User             @relation("DocumentUploadedBy", fields: [uploadedByUserId], references: [id])
  createdAt        DateTime         @default(now())

  // ---- SOP versioning (Phase 2) ----
  // No dedicated "SOP Library" screen exists in the template yet (isCalendar
  // turned out to be a shift/leave calendar, not an SOP screen) — versioning
  // lives on the existing company-wide Document (category=SOP) so it's real
  // data, surfaced today only inside the existing Document Library card text.
  // version      starts at 1; supersedesId points back at the version this
  // one replaces (a real one-to-one chain, walk supersedesId to see history).
  version      Int       @default(1)
  supersedesId String?   @unique
  supersedes   Document? @relation("DocumentVersion", fields: [supersedesId], references: [id])
  supersededBy Document? @relation("DocumentVersion")
}

model ShiftRosterEntry {
  id              String    @id @default(cuid())
  branch          String
  weekStart       DateTime
  dayOfWeek       Int // 0=Mon .. 6=Sun
  shiftType       ShiftType
  employeeId      String?
  employee        Employee? @relation(fields: [employeeId], references: [id])
  published       Boolean   @default(false)
  publishedAt     DateTime?
  createdByUserId String?
  createdBy       User?     @relation("RosterCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([branch, weekStart, dayOfWeek, shiftType])
}

model AttendanceRecord {
  id                String           @id @default(cuid())
  employeeId        String
  employee          Employee         @relation(fields: [employeeId], references: [id])
  date              DateTime
  clockIn           DateTime?
  clockOut          DateTime?
  status            AttendanceStatus @default(ON_TIME)
  correctedByUserId String?
  correctedBy       User?            @relation("AttendanceCorrectedBy", fields: [correctedByUserId], references: [id])
  correctionNote    String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([employeeId, date])
}

model LeaveRequest {
  id              String      @id @default(cuid())
  employeeId      String
  employee        Employee    @relation(fields: [employeeId], references: [id])
  type            LeaveType
  startDate       DateTime
  endDate         DateTime
  days            Int
  status          LeaveStatus @default(PENDING)
  reason          String?
  decidedByUserId String?
  decidedBy       User?       @relation("LeaveDecidedBy", fields: [decidedByUserId], references: [id])
  decidedAt       DateTime?
  createdAt       DateTime    @default(now())
}

model PayrollRun {
  id               String           @id @default(cuid())
  period           String // e.g. "2026-07"
  status           PayrollRunStatus @default(DRAFT)
  createdByUserId  String
  createdBy        User             @relation("PayrollCreatedBy", fields: [createdByUserId], references: [id])
  approvedByUserId String?
  approvedBy       User?            @relation("PayrollApprovedBy", fields: [approvedByUserId], references: [id])
  approvedAt       DateTime?
  createdAt        DateTime         @default(now())

  payslips Payslip[]

  @@unique([period])
}

model Payslip {
  id              String     @id @default(cuid())
  payrollRunId    String
  payrollRun      PayrollRun @relation(fields: [payrollRunId], references: [id])
  employeeId      String
  employee        Employee   @relation(fields: [employeeId], references: [id])
  grossPay        Decimal    @db.Decimal(12, 2)
  overtimePay     Decimal    @default(0) @db.Decimal(12, 2)
  otherDeductions Decimal    @default(0) @db.Decimal(12, 2)
  deductionNote   String?
  ssnitEmployee   Decimal    @db.Decimal(12, 2)
  ssnitEmployer   Decimal    @db.Decimal(12, 2)
  payeTax         Decimal    @db.Decimal(12, 2)
  netPay          Decimal    @db.Decimal(12, 2)
  createdAt       DateTime   @default(now())

  @@unique([payrollRunId, employeeId])
}

// Real, editable statutory-rate table — never hard-code SSNIT/PAYE in app logic.
// Seeded with plausible current-ish Ghana rates; FLAGGED as placeholders
// pending accountant/Director sign-off (see brief's compliance note).
model PayrollSettings {
  id                   String   @id @default(cuid())
  ssnitEmployeeRatePct Decimal  @db.Decimal(5, 2) // employee SSNIT contribution, e.g. 5.5
  ssnitEmployerRatePct Decimal  @db.Decimal(5, 2) // employer SSNIT contribution, e.g. 13.0
  payeBands            Json // [{ upTo: number|null, rate: number }] cumulative monthly GHS bands
  effectiveFrom        DateTime @default(now())
  notes                String?
  updatedByUserId      String?
  updatedBy            User?    @relation("SettingsUpdatedBy", fields: [updatedByUserId], references: [id])
  updatedAt            DateTime @updatedAt
  createdAt            DateTime @default(now())
}

// ============== Phase 2 (Operations & Performance) ==============

// Recruitment — job openings + candidate pipeline. HR Officer owns this
// (Director has full access, matching the brief's role table).
model JobOpening {
  id              String           @id @default(cuid())
  title           String
  branch          String
  status          JobOpeningStatus @default(OPEN)
  openings        Int              @default(1)
  createdByUserId String
  createdBy       User             @relation("JobOpeningCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime         @default(now())

  candidates Candidate[]
}

model Candidate {
  id                  String         @id @default(cuid())
  name                String
  email               String
  phone               String?
  jobOpeningId        String?
  jobOpening          JobOpening?    @relation(fields: [jobOpeningId], references: [id])
  roleTitle           String // denormalized display label, e.g. "Support Agent · Night shift"
  stage               CandidateStage @default(APPLIED)
  experience          String?
  education           String?
  notes               String?
  appliedAt           DateTime       @default(now())
  // Set once, by the one-click "hire" conversion — creates a real Employee
  // (+ User login, same generated-temp-password mechanism as
  // app/api/employees/onboard) and links back here. @unique enforces a
  // candidate can only ever be converted once.
  convertedEmployeeId String?        @unique
  convertedEmployee   Employee?      @relation(fields: [convertedEmployeeId], references: [id])
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

// Quality Assurance — one row per audited ticket/interaction. Feeds both the
// QA screen's agent scorecards/recent-audits table AND the KPI screen's
// individual performance score (QA is 40% of that score).
model QaAudit {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id])
  ticketRef       String
  score           Int // 0-100
  note            String?
  auditedByUserId String
  auditedBy       User     @relation("QaAuditedBy", fields: [auditedByUserId], references: [id])
  createdAt       DateTime @default(now())
}

// Incidents & handover — severity, owner, resolution status.
model Incident {
  id             String           @id @default(cuid())
  employeeId     String
  employee       Employee         @relation(fields: [employeeId], references: [id])
  type           IncidentType
  severity       IncidentSeverity @default(LOW)
  detail         String
  action         String?
  status         IncidentStatus   @default(OPEN)
  ownerUserId    String // the person logging it is the default owner/follow-up contact
  owner          User             @relation("IncidentOwner", fields: [ownerUserId], references: [id])
  closedByUserId String?
  closedBy       User?            @relation("IncidentClosedBy", fields: [closedByUserId], references: [id])
  closedAt       DateTime?
  createdAt      DateTime         @default(now())
}

// Training — course catalogue, cohorts, and per-employee completion tracking.
model Course {
  id            String       @id @default(cuid())
  name          String       @unique
  modules       Int
  durationHours Decimal      @db.Decimal(4, 1)
  status        CourseStatus @default(LIVE)
  createdAt     DateTime     @default(now())

  cohorts     Cohort[]
  completions TrainingCompletion[]
}

model Cohort {
  id        String   @id @default(cuid())
  name      String   @unique
  courseId  String?
  course    Course?  @relation(fields: [courseId], references: [id])
  startDate DateTime @default(now())
  createdAt DateTime @default(now())

  completions TrainingCompletion[]
}

model TrainingCompletion {
  id               String         @id @default(cuid())
  employeeId       String
  employee         Employee       @relation(fields: [employeeId], references: [id])
  courseId         String
  course           Course         @relation(fields: [courseId], references: [id])
  cohortId         String?
  cohort           Cohort?        @relation(fields: [cohortId], references: [id])
  status           TrainingStatus @default(ENROLLED)
  completedAt      DateTime?
  recordedByUserId String?
  recordedBy       User?          @relation("TrainingRecordedBy", fields: [recordedByUserId], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([employeeId, courseId])
}

// KPI targets — Director-editable, real target values that real actuals
// (computed live from Attendance/QaAudit) are scored against. Only the two
// metrics Phase 1 data can genuinely support (see KpiMetricKey comment).
model KpiTarget {
  id              String       @id @default(cuid())
  metricKey       KpiMetricKey @unique
  label           String
  targetValue     Decimal      @db.Decimal(6, 2)
  unit            String // '%' or 'pts'
  updatedByUserId String?
  updatedBy       User?        @relation("KpiTargetUpdatedBy", fields: [updatedByUserId], references: [id])
  updatedAt       DateTime     @updatedAt
  createdAt       DateTime     @default(now())
}

model AuditLogEntry {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id])
  actorEmail  String
  action      String
  targetType  String
  targetId    String?
  detail      Json?
  createdAt   DateTime @default(now())
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// ============== Phase 3 (Client Portal & Assets) ==============
// Client Portal itself is explicitly OUT of scope for this phase (it needs a
// real Client entity that only gets created by the Sales & CRM "convert deal
// to client" flow — Phase 4, not built yet) — see lib/roles.js's comment on
// this. The models below are the parts of Phase 3 that stand on their own:
// Asset Tracking and IT & Facilities (ticketing / systems / maintenance /
// procurement). The Board Dashboard and Compliance Store needed no new
// models — they reuse KpiTarget/Attendance/QaAudit/Incident aggregates and
// the existing Document model (+ new COMPLIANCE category above),
// respectively.

enum AssetCondition {
  GOOD
  FAIR
  NEEDS_REPAIR
  RETIRED
}

enum AssetStatus {
  IN_STORAGE
  ASSIGNED
  RETIRED
}

// Laptops/phones/equipment register — one row per physical item, tagged
// with a unique asset tag (matches the existing "OBA-LT-0142" style already
// shown in the Facilities screen's Asset register table).
model Asset {
  id                   String         @id @default(cuid())
  name                 String
  tag                  String         @unique
  category             String // e.g. Laptop / Phone / Headset / Printer / Furniture — free text, matches existing UI's varied equipment types
  branch               String
  condition            AssetCondition @default(GOOD)
  status               AssetStatus    @default(IN_STORAGE)
  assignedToEmployeeId String?
  assignedTo           Employee?      @relation(fields: [assignedToEmployeeId], references: [id])
  assignedAt           DateTime?
  assignedByUserId     String?
  assignedBy           User?          @relation("AssetAssignedBy", fields: [assignedByUserId], references: [id])
  returnedAt           DateTime? // set when the asset is returned (e.g. on employee exit) — a real "on exit" return trail, not just a status flip
  notes                String?
  registeredByUserId   String
  registeredBy         User           @relation("AssetRegisteredBy", fields: [registeredByUserId], references: [id])
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  DONE
}

model ITTicket {
  id               String         @id @default(cuid())
  title            String
  branch           String
  priority         TicketPriority @default(MEDIUM)
  status           TicketStatus   @default(OPEN)
  detail           String?
  reportedByUserId String?
  reportedBy       User?          @relation("TicketReportedBy", fields: [reportedByUserId], references: [id])
  startedAt        DateTime?
  resolvedByUserId String?
  resolvedBy       User?          @relation("TicketResolvedBy", fields: [resolvedByUserId], references: [id])
  closedAt         DateTime?
  createdAt        DateTime       @default(now())
}

enum SystemHealthStatus {
  ONLINE
  DEGRADED
  OFFLINE
}

// "Systems uptime" — genuinely real rows that IT & Facilities updates by
// hand (there is no real infra to poll for uptime in this deployment), so
// the status shown is a real, IT-maintained record rather than a randomly
// generated number pretending to be live monitoring.
model SystemStatus {
  id              String             @id @default(cuid())
  name            String             @unique
  detail          String?
  status          SystemHealthStatus @default(ONLINE)
  updatedByUserId String?
  updatedBy       User?              @relation("SystemStatusUpdatedBy", fields: [updatedByUserId], references: [id])
  updatedAt       DateTime           @updatedAt
  createdAt       DateTime           @default(now())
}

enum MaintenanceStatus {
  SCHEDULED
  DONE
}

model MaintenanceTask {
  id              String            @id @default(cuid())
  task            String
  location        String
  dueLabel        String // free text due date/label (e.g. "Fri 24 Jul", "3 Aug") — matches the existing UI's mixed date/relative labels
  status          MaintenanceStatus @default(SCHEDULED)
  createdByUserId String
  createdBy       User              @relation("MaintenanceCreatedBy", fields: [createdByUserId], references: [id])
  completedAt     DateTime?
  createdAt       DateTime          @default(now())
}

enum ProcurementStatus {
  PENDING
  APPROVED
  DENIED
  // Phase 4 — set when the ordered item physically arrives. Marking a
  // request RECEIVED is the trigger that posts its cost to the Finance
  // expense ledger automatically (see postedExpenseId below and
  // app/api/facilities/procurement/[id]/receive/route.js).
  RECEIVED
}

model ProcurementRequest {
  id                String            @id @default(cuid())
  item              String
  costLabel         String // free text, matches the existing "GH₵ cost" input (e.g. "GH₵ 4,000")
  reason            String
  status            ProcurementStatus @default(PENDING)
  requestedByUserId String
  requestedBy       User              @relation("ProcurementRequestedBy", fields: [requestedByUserId], references: [id])
  decidedByUserId   String?
  decidedBy         User?             @relation("ProcurementDecidedBy", fields: [decidedByUserId], references: [id])
  decidedAt         DateTime?
  // Phase 4 — receiving leg of the workflow, additive to the Phase 3
  // approve/deny decision above.
  receivedByUserId  String?
  receivedBy        User?             @relation("ProcurementReceivedBy", fields: [receivedByUserId], references: [id])
  receivedAt        DateTime?
  postedExpenseId   String?           @unique
  postedExpense     Expense?          @relation(fields: [postedExpenseId], references: [id])
  createdAt         DateTime          @default(now())
}

// ============== Phase 4 (Growth & Finance) ==============
// Sales & CRM pipeline, Client Portal's real Client entity, Finance (P&L /
// expense ledger / bank reconciliation / tax calendar), Contracts register,
// and Credentials Vault. See lib/roles.js for the matching permission
// groups and app/api/{sales,portal,finance,contracts,vault}/** for routes.

enum DealStage {
  NEW_ENQUIRY
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

enum DealContactType {
  CALL
  EMAIL
  MEETING
}

enum ClientStatus {
  ONBOARDING
  ACTIVE
  PAUSED
  ENDED
}

enum ClientHealth {
  EXCELLENT
  GOOD
  ATTENTION
  AT_RISK
}

// A won deal converts into exactly one Client (see Deal.convertedClientId).
// Everything a Client Portal login can see is scoped to this row's id —
// Employee.clientId (staffing), Contract.clientId (agreements), and the
// portal summary/report routes all filter on it server-side.
model Client {
  id           String       @id @default(cuid())
  name         String
  region       String
  industry     String
  currency     String       @default("GH₵")
  slaTargetPct Decimal?     @db.Decimal(5, 2)
  status       ClientStatus @default(ONBOARDING)
  health       ClientHealth @default(GOOD)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  dealSource  Deal? // reverse of Deal.convertedClientId (1:1)
  staff       Employee[]
  contracts   Contract[]
  portalUsers User[]
  invoices    Invoice[]
  documents   Document[]
  supportRequests ClientSupportRequest[]
}

model Deal {
  id                String    @id @default(cuid())
  company           String
  contactName       String?
  contactEmail      String?
  contactPhone      String?
  region            String    @default("Ghana")
  serviceDesc       String
  valueAmount       Decimal?  @db.Decimal(12, 2)
  currency          String    @default("$")
  source            String    @default("Website")
  stage             DealStage @default(NEW_ENQUIRY)
  lostReason        String?
  createdByUserId   String?
  createdBy         User?     @relation("DealCreatedBy", fields: [createdByUserId], references: [id])
  // Set once, by the one-click "Convert to client" action — creates a real
  // Client + Contract + JobOpening in one transaction (see
  // app/api/sales/deals/[id]/convert). @unique enforces a deal converts at
  // most once.
  convertedClientId String?   @unique
  convertedClient   Client?   @relation(fields: [convertedClientId], references: [id])
  convertedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  contactLogs DealContactLog[]
}

// Call/email/meeting notes against a deal — the brief's "contact log".
model DealContactLog {
  id              String          @id @default(cuid())
  dealId          String
  deal            Deal            @relation(fields: [dealId], references: [id])
  type            DealContactType
  note            String
  createdByUserId String
  createdBy       User            @relation("DealContactLogCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime        @default(now())
}

enum ContractType {
  CLIENT
  STAFF
  VENDOR
}

enum ContractStatus {
  ACTIVE
  RENEWAL_DUE
  EXPIRED
  TERMINATED
}

// Single register for client/staff/vendor agreements. A CLIENT contract is
// created automatically by the Sales conversion handoff; STAFF/VENDOR rows
// are added directly by Director/Accountant.
model Contract {
  id                   String         @id @default(cuid())
  type                 ContractType
  title                String
  clientId             String?
  client               Client?        @relation(fields: [clientId], references: [id])
  employeeId           String?
  employee             Employee?      @relation(fields: [employeeId], references: [id])
  vendorName           String?
  value                Decimal?       @db.Decimal(12, 2)
  currency             String         @default("GH₵")
  startDate            DateTime
  endDate              DateTime?
  renewalDueDate       DateTime?
  status               ContractStatus @default(ACTIVE)
  notes                String?
  reminderSentAt       DateTime?
  reminderSentByUserId String?
  reminderSentBy       User?          @relation("ContractReminderBy", fields: [reminderSentByUserId], references: [id])
  createdByUserId      String?
  createdBy            User?          @relation("ContractCreatedBy", fields: [createdByUserId], references: [id])
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  invoices Invoice[]
}

enum ExpenseSource {
  MANUAL
  PAYROLL
  PROCUREMENT
}

// Company expense ledger. PAYROLL-sourced rows are posted automatically from
// an approved PayrollRun's payslip totals (see app/api/finance/pnl and the
// payroll-approve route) rather than duplicated as a separately-mocked P&L
// number; PROCUREMENT-sourced rows post automatically when a
// ProcurementRequest is marked RECEIVED.
model Expense {
  id              String        @id @default(cuid())
  category        String
  description     String
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("GH₵")
  date            DateTime      @default(now())
  source          ExpenseSource @default(MANUAL)
  sourceRef       String? // e.g. the PayrollRun.id or ProcurementRequest.id this posted from
  createdByUserId String?
  createdBy       User?         @relation("ExpenseCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime      @default(now())

  procurementRequest ProcurementRequest?
  bankMatch          BankStatementLine?
}

// Bank statement lines to reconcile against ledger (Expense) entries.
model BankStatementLine {
  id               String    @id @default(cuid())
  date             DateTime
  description      String
  amount           Decimal   @db.Decimal(12, 2)
  matchedExpenseId String?   @unique
  matchedExpense   Expense?  @relation(fields: [matchedExpenseId], references: [id])
  matchedByUserId  String?
  matchedBy        User?     @relation("BankLineMatchedBy", fields: [matchedByUserId], references: [id])
  matchedAt        DateTime?
  importedByUserId String?
  importedBy       User?     @relation("BankLineImportedBy", fields: [importedByUserId], references: [id])
  createdAt        DateTime  @default(now())
}

enum TaxFilingType {
  PAYE
  SSNIT
  VAT
  CORPORATE_TAX
}

// Statutory tax/filing calendar. One row per (type, period) — seeded ahead
// for the current + next period so the calendar always shows upcoming due
// dates, and marked filed by the Accountant/Director as each is actually
// filed with GRA/SSNIT.
model TaxFiling {
  id            String        @id @default(cuid())
  type          TaxFilingType
  period        String // e.g. "2026-07"
  dueDate       DateTime
  amount        Decimal?      @db.Decimal(12, 2)
  filed         Boolean       @default(false)
  filedAt       DateTime?
  filedByUserId String?
  filedBy       User?         @relation("TaxFilingFiledBy", fields: [filedByUserId], references: [id])
  notes         String?
  createdAt     DateTime      @default(now())

  @@unique([type, period])
}

enum VaultCategory {
  BANKING
  GOVERNMENT
  SOFTWARE
  SOCIAL
  OTHER
}

// Shared company logins, restricted to Director + IT & Facilities (see
// lib/roles.js VAULT_*). The password is genuinely encrypted at rest with
// AES-256-GCM (lib/vault-crypto.js), keyed off VAULT_ENCRYPTION_KEY — never
// stored or logged in plaintext. Every reveal/copy writes an AuditLogEntry
// (see app/api/vault/[id]/reveal).
model VaultCredential {
  id              String        @id @default(cuid())
  system          String
  category        VaultCategory @default(OTHER)
  username        String
  encIv           String // base64 AES-GCM IV
  encTag          String // base64 AES-GCM auth tag
  encData         String // base64 ciphertext
  // A real (not fabricated) strength heuristic computed from the actual
  // plaintext ONCE at write time (see lib/vault-crypto.js's caller), then
  // stored as a plain label — lets the list view show it without ever
  // decrypting on a bare GET.
  strength        String        @default("Medium")
  notes           String?
  createdByUserId String
  createdBy       User          @relation("VaultCredentialCreatedBy", fields: [createdByUserId], references: [id])
  updatedAt       DateTime      @updatedAt
  createdAt       DateTime      @default(now())
}

// ============== Invoices (brief section 3A) ==============
// Real billing register generated from real Client + Contract data (Phase
// 4), replacing the client-side-only mock the Invoices screen used to run
// on. Only DRAFT/SENT/PAID are ever actually persisted/written by an actor
// (see app/api/invoices/[id]/status — a real, role-gated, audited state
// machine: DRAFT -> SENT -> PAID). OVERDUE is deliberately NOT a fourth
// state a human clicks into — it's derived at read time from
// (status === SENT && dueDate < now), exactly the same pattern this
// codebase already uses for Contract.status's RENEWAL_DUE/EXPIRED (see
// app/api/contracts's renewalStatus()) — an invoice that's overdue doesn't
// stop being "sent, unpaid", it just becomes late, and the moment it's
// actually paid the real status transition is still SENT -> PAID. Kept in
// the enum anyway so the shape matches the brief's literal status list.
enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
}

model Invoice {
  id              String            @id @default(cuid())
  clientId        String
  client          Client            @relation(fields: [clientId], references: [id])
  // Optional — set when generated off a specific Contract (the common case:
  // billing a client's existing retainer), left null for a one-off/ad-hoc
  // invoice raised directly against the client with no linked agreement.
  contractId      String?
  contract        Contract?         @relation(fields: [contractId], references: [id])
  period          String // e.g. "2026-07" — the billing period this invoice covers
  currency        String            @default("$")
  // Denormalized SUBTOTAL (sum of lineItems' amounts, pre-tax), recomputed
  // server-side on every write (never trust a client-supplied total) — see
  // app/api/invoices. Real tax due on top of this is the vat/nhil/getfund/
  // covidLevy fields below; totalAmount is the actual grand total to collect.
  amount          Decimal           @db.Decimal(12, 2)
  // Whether this invoice is treated as an export of services (VAT/levy
  // exempt) vs. standard-rated. Defaulted at creation time from
  // Client.currency === '$' as a starting-point signal (a USD-billed client
  // is presumptively an international/export engagement) but always an
  // explicit, overridable choice made by Accountant/Director when raising
  // the invoice (see app/api/invoices POST) — never silently inferred with
  // no way to correct it.
  taxExempt       Boolean           @default(false)
  // Real tax breakdown, computed from the InvoiceTaxSettings row in effect
  // at creation time and SNAPSHOTTED here (same pattern as Payslip snapshots
  // PayrollSettings' rates) so a later edit to InvoiceTaxSettings never
  // silently changes the amount already invoiced to a client. All zero when
  // taxExempt is true.
  vatAmount       Decimal           @default(0) @db.Decimal(12, 2)
  nhilAmount      Decimal           @default(0) @db.Decimal(12, 2)
  getfundAmount   Decimal           @default(0) @db.Decimal(12, 2)
  covidLevyAmount Decimal           @default(0) @db.Decimal(12, 2)
  // amount + vatAmount + nhilAmount + getfundAmount + covidLevyAmount (or
  // just amount when taxExempt) — the real amount actually due, shown as
  // "Total due" on the invoice/PDF/email, NOT `amount` alone.
  totalAmount     Decimal           @db.Decimal(12, 2)
  status          InvoiceStatus     @default(DRAFT)
  dueDate         DateTime?
  sentAt          DateTime?
  paidAt          DateTime?
  createdByUserId String?
  createdBy       User?             @relation("InvoiceCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  lineItems InvoiceLineItem[]

  @@index([clientId])
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2) // quantity * unitPrice, computed server-side
}

// Real, editable VAT/levy-rate table for invoicing — never hard-code tax
// rates in application logic, same compliance principle (and same shape) as
// PayrollSettings above. Ghana's real tax stack on a standard-rated invoiced
// service is not a single VAT number — it's VAT plus several additional
// levies (NHIL, GETFund Levy, COVID-19 Health Recovery Levy) that apply on
// top of it. The rates below are PLACEHOLDERS pending accountant/tax-advisor
// sign-off (see seed script + final report) — so is the computation itself:
// this implementation applies each rate independently to the invoice
// subtotal (a simplified, non-compounding calculation). Ghana's actual VAT
// Flat Rate Scheme may compound these differently (e.g. VAT charged on
// subtotal+levies rather than on the subtotal alone) — that exact order has
// NOT been verified against current GRA guidance and must be confirmed by
// an accountant before any real invoice's tax line is relied upon.
model InvoiceTaxSettings {
  id                String   @id @default(cuid())
  vatRatePct        Decimal  @db.Decimal(5, 2) // headline VAT rate, e.g. 15.0 — PLACEHOLDER
  nhilRatePct       Decimal  @db.Decimal(5, 2) // National Health Insurance Levy — PLACEHOLDER
  getfundRatePct    Decimal  @db.Decimal(5, 2) // GETFund Levy — PLACEHOLDER
  covidLevyRatePct  Decimal  @db.Decimal(5, 2) // COVID-19 Health Recovery Levy — PLACEHOLDER
  effectiveFrom     DateTime @default(now())
  notes             String?
  updatedByUserId   String?
  updatedBy         User?    @relation("InvoiceTaxSettingsUpdatedBy", fields: [updatedByUserId], references: [id])
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())
}

// ============== Client Portal support requests ==============
// A real, minimal ticket-style model for the Client Portal's "Support
// requests" panel, replacing what was previously a client-side-only mock
// thread. Shape deliberately mirrors Phase 3's ITTicket (title/status/who-
// reported-it) rather than duplicating a second unrelated pattern, adapted
// for a two-way client<->OBA conversation via ClientSupportMessage instead
// of ITTicket's single detail/resolution fields.
enum SupportRequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model ClientSupportRequest {
  id              String               @id @default(cuid())
  clientId        String
  client          Client               @relation(fields: [clientId], references: [id])
  title           String
  status          SupportRequestStatus @default(OPEN)
  createdByUserId String?
  createdBy       User?                @relation("SupportRequestCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  messages ClientSupportMessage[]

  @@index([clientId])
}

model ClientSupportMessage {
  id           String               @id @default(cuid())
  requestId    String
  request      ClientSupportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorUserId String
  author       User                 @relation("SupportMessageAuthor", fields: [authorUserId], references: [id])
  // true when authored by the CLIENT-role user on this thread, false when an
  // internal OBA role (Director/Business Development) replied — drives the
  // portal UI's left/right message alignment without re-deriving it from
  // author.role on every render.
  fromClient   Boolean
  body         String
  createdAt    DateTime             @default(now())
}
